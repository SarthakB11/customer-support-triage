# Copy to .env and fill in from Lamatic Studio. .env is gitignored.
LAMATIC_ENDPOINT=https://<org>-<project>.lamatic.dev/graphql     # Flow > Setup > API, or Settings > General
LAMATIC_PROJECT_ID=                                                # Settings > General > Project ID
LAMATIC_WORKFLOW_ID=                                               # Flow > Setup ("Flow ID")
LAMATIC_API_KEY=                                                   # Settings > API Keys > Create API Key
